root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C# / .NET
[*.{cs,csx}]
indent_size = 4
# Prefer file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:error
# var preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
# Naming: private fields -> _camelCase
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case_underscore_prefix
dotnet_naming_rule.private_fields_camel_case.severity = error
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore_prefix.capitalization = camel_case
dotnet_naming_style.camel_case_underscore_prefix.required_prefix = _
# Naming: interfaces -> IPascalCase
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = pascal_case_i_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = error
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.pascal_case_i_prefix.capitalization = pascal_case
dotnet_naming_style.pascal_case_i_prefix.required_prefix = I

[*.{csproj,sln,props,targets}]
indent_size = 2

# Web / scripts
[*.{ts,tsx,js,jsx,json,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
